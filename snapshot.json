ry","name":"空间距离","sortOrder":2905},{"id":"solid-section","parentId":"solid-geometry","name":"截面与几何体展开","sortOrder":2906},{"id":"spatial-vector-operations","parentId":"spatial-vectors","name":"空间向量运算","sortOrder":3000},{"id":"spatial-vector-coordinates","parentId":"spatial-vectors","name":"空间直角坐标系","sortOrder":3001},{"id":"spatial-vector-normal","parentId":"spatial-vectors","name":"平面法向量","sortOrder":3002},{"id":"spatial-vector-parallel","parentId":"spatial-vectors","name":"向量证明平行","sortOrder":3003},{"id":"spatial-vector-perpendicular","parentId":"spatial-vectors","name":"向量证明垂直","sortOrder":3004},{"id":"spatial-vector-angle","parentId":"spatial-vectors","name":"二面角与线面角","sortOrder":3005},{"id":"spatial-vector-distance","parentId":"spatial-vectors","name":"向量求距离","sortOrder":3006},{"id":"classical-probability","parentId":"probability","name":"古典概型","sortOrder":3100},{"id":"geometric-probability","parentId":"probability","name":"几何概型","sortOrder":3101},{"id":"probability-addition","parentId":"probability","name":"互斥事件与加法公式","sortOrder":3102},{"id":"probability-independence","parentId":"probability","name":"独立事件","sortOrder":3103},{"id":"conditional-probability","parentId":"probability","name":"条件概率","sortOrder":3104},{"id":"binomial-distribution","parentId":"probability","name":"二项分布","sortOrder":3105},{"id":"hypergeometric-distribution","parentId":"probability","name":"超几何分布","sortOrder":3106},{"id":"random-variable","parentId":"probability","name":"离散型随机变量","sortOrder":3107},{"id":"expectation-variance","parentId":"probability","name":"期望与方差","sortOrder":3108},{"id":"normal-distribution","parentId":"probability","name":"正态分布","sortOrder":3109},{"id":"data-sampling","parentId":"statistics","name":"随机抽样","sortOrder":3200},{"id":"data-frequency","parentId":"statistics","name":"频率分布与图表","sortOrder":3201},{"id":"data-mean-variance","parentId":"statistics","name":"均值、方差与标准差","sortOrder":3202},{"id":"data-quantiles","parentId":"statistics","name":"百分位数与箱线图","sortOrder":3203},{"id":"data-estimation","parentId":"statistics","name":"总体估计","sortOrder":3204},{"id":"data-regression","parentId":"statistics","name":"线性回归","sortOrder":3205},{"id":"data-independence","parentId":"statistics","name":"独立性检验","sortOrder":3206},{"id":"data-correlation","parentId":"statistics","name":"相关关系与成对数据","sortOrder":3207},{"id":"counting-principles","parentId":"counting","name":"分类与分步计数","sortOrder":3300},{"id":"permutations","parentId":"counting","name":"排列","sortOrder":3301},{"id":"combinations","parentId":"counting","name":"组合","sortOrder":3302},{"id":"counting-restrictions","parentId":"counting","name":"有限制条件的排列组合","sortOrder":3303},{"id":"binomial-theorem","parentId":"counting","name":"二项式定理","sortOrder":3304},{"id":"binomial-coefficients","parentId":"counting","name":"二项式系数与特定项","sortOrder":3305},{"id":"complex-operations","parentId":"complex","name":"复数四则运算","sortOrder":3400},{"id":"complex-plane","parentId":"complex","name":"复平面与几何意义","sortOrder":3401},{"id":"complex-modulus","parentId":"complex","name":"复数模与共轭","sortOrder":3402},{"id":"complex-equations","parentId":"complex","name":"复数与方程","sortOrder":3403}],"sources":[{"id":"a72493f2-8e1e-46e3-a626-e9db1029e9a5","title":"2000年上海市普通高等学校春季招生考试数学试卷","category":"上海高考","region":"上海","school":"","schoolTier":"","examType":"其他","examYear":2000,"term":"","paper":"","createdAt":"2026-09-25 07:25:06"}],"questions":[{"id":"4ebede16-0463-4e03-8ab3-dcbf1d94319e","sourceId":"a72493f2-8e1e-46e3-a626-e9db1029e9a5","questionYear":2000,"paperTitle":"2000年上海市普通高等学校春季招生考试数学试卷","questionNumber":"17","questionType":"解答题","stemLatex":"17. (本题满分10分)\n设 $f(x)$ 为定义在 $\\mathrm R$ 上的偶函数, 当 $x\\leqslant-1$ 时, $y=f(x)$ 的图像是经过点 $(-2, 0)$, 斜率为 $1$ 的射线. 又在 $y=f(x)$ 的图像中有一部分是顶点在 $(0, 2)$, 且过点 $(-1, 1)$ 的一段抛物线. 试写出函数 $f(x)$ 的表达式, 并作出其图像.","answerLatex":"$f(x)=\\begin{cases}x+2,&x\\leqslant-1,\\\\2-x^2,&-1<x<1,\\\\-x+2,&x\\geqslant1.\\end{cases}$ 图像见原书第5页题17所附函数图像.","officialAnswer":"$f(x)=\\begin{cases}x+2,&x\\leqslant-1,\\\\2-x^2,&-1<x<1,\\\\-x+2,&x\\geqslant1.\\end{cases}$; 原书附有函数图像.","officialSolution":"当 $x\\leqslant-1$ 时, 设 $f(x)=x+b$, 则由 $0=-2+b$, 即 $b=2$, 得 $f(x)=x+2$; 当 $-1<x<1$ 时, 设 $f(x)=ax^2+2$, 则由 $1=a(-1)^2+2$, 即 $a=-1$, 得 $f(x)=-x^2+2$; 当 $x\\geqslant1$ 时, $f(x)=-x+2$.\n\n故 $f(x)=\\begin{cases}x+2,&x\\leqslant-1,\\\\2-x^2,&-1<x<1,\\\\-x+2,&x\\geqslant1.\\end{cases}$ 原书另附函数图像, 区域见第5页图.","officialSource":"原书第5页（印刷页码186）“答案要点”第17题及所附函数图像","aiSolution":"(1) 求表达式. 当 $x\\leqslant-1$ 时, 图像是斜率为 $1$, 经过 $(-2, 0)$ 的射线, 由点斜式得 $f(x)=x+2$. 中间一段抛物线的顶点为 $(0, 2)$, 可设其表达式为 $f(x)=ax^2+2$.\n\n代入点 $(-1, 1)$, 得 $1=a+2$, 所以 $a=-1$, 即 $f(x)=2-x^2$.\n\n由于 $f$ 是偶函数, 图像关于 $y$ 轴对称; 左侧射线对称到右侧后, $x\\geqslant1$ 时 $f(x)=2-x$.\n\n因此 $f(x)=\\begin{cases}x+2,&x\\leqslant-1,\\\\2-x^2,&-1<x<1,\\\\2-x,&x\\geqslant1.\\end{cases}$\n(2) 作图. 在 $x\\leqslant-1$ 的范围画过 $(-2, 0)$, $(-1, 1)$ 的射线; 在 $-1<x<1$ 的范围画抛物线 $y=2-x^2$, 其顶点为 $(0, 2)$;\n\n再关于 $y$ 轴作左侧射线的对称图像, 即 $x\\geqslant1$ 时的射线 $y=2-x$. 两端射线与中间抛物线在 $(-1, 1)$, $(1, 1)$ 处衔接. 所作图像如下.\n\n参考作图:\n\n\\begin{tikzpicture}[x=0.95cm, y=0.95cm,>=Stealth]\n\\draw[->] (-3.45, 0)--(3.45, 0) node[right] {$x$};\n\\draw[->] (0,-1.45)--(0, 2.75) node[above] {$y$};\n\\draw[very thick] (-3.2,-1.2)--(-1, 1);\n\\draw[very thick, domain=-1: 1, samples=80, smooth] plot (\\x,{2-\\x*\\x});\n\\draw[very thick] (1, 1)--(3.2,-1.2);\n\\fill (-2, 0) circle (1.5pt) node[below left] {$(-2, 0)$};\n\\fill (-1, 1) circle (1.5pt) node[above left] {$(-1, 1)$};\n\\fill (0, 2) circle (1.5pt) node[above right] {$(0, 2)$};\n\\fill (1, 1) circle (1.5pt) node[above right] {$(1, 1)$};\n\\fill (2, 0) circle (1.5pt) node[below right] {$(2, 0)$};\n\\end{tikzpicture}","assetUploadId":null,"difficulty":3,"updatedAt":"2026-09-25 13:28:48","topicIds":["function-expression","function-parity","quadratic-function"],"assetUrl":null,"tikzUrls":[],"solutionTikzUrls":["assets/4ebede16-0463-4e03-8ab3-dcbf1d94319e-solution-tikz-1.png"]},{"id":"6895919a-99ac-45de-bb93-8be682f51e7f","sourceId":"a72493f2-8e1e-46e3-a626-e9db1029e9a5","questionYear":2000,"paperTitle":"2000年上海市普通高等学校春季招生考试数学试卷","questionNumber":"16","questionType":"选择题","stemLatex":"若 $0<a<1, b<-1$, 则函数 $f(x)=a^x+b$ 的图象不经过\n\n(A) 第一象限.\n(B) 第二象限.\n(C) 第三象限.\n(D) 第四象限.","answerLatex":"$\\mathrm{A}$","officialAnswer":"A","officialSolution":"","officialSource":"原件第5页“答案要点”，第16题","aiSolution":"由 $0<a<1$ 可知, 指数函数 $a^x$ 在实数范围内递减. 第一步, 若 $x>0$, 则 $0<a^x<1$;\n\n又因为 $b<-1$, 所以 $f(x)=a^x+b<1+b<0$.\n\n因此图象不经过第一象限. 第二步, 若 $x<0$, 则 $a^x>1$, 且当 $x\\to-\\infty$ 时, $a^x\\to+\\infty$.\n\n由于 $b<-1$, 当 $x$ 接近 $0$ 且仍小于 $0$ 时, $f(x)$ 为负; 当 $x$ 充分小时, $f(x)$ 为正.\n\n因此图象经过第三, 第二象限. 第三步, 取 $x>0$, 已知 $f(x)<0$, 故图象经过第四象限.\n\n综上, 图象不经过第一象限, 选 $\\mathrm{A}$.","assetUploadId":null,"difficulty":2,"updatedAt":"2026-09-25 12:50:08","topicIds":["exponential-function","function-range"],"assetUrl":null,"tikzUrls":[],"solutionTikzUrls":[]},{"id":"ec00d7da-a1d4-465d-b7ba-0bbfe060003c","sourceId":"a72493f2-8e1e-46e3-a626-e9db1029e9a5","questionYear":2000,"paperTitle":"2000年上海市普通高等学校春季招生考试数学试卷","questionNumber":"15","questionType":"选择题","stemLatex":"\"$a=1$\"是\"函数 $y=\\cos^2 ax-\\sin^2 ax$ 的最小正周期为 $\\pi$\"的\n\n(A) 充分不必要条件.\n(B) 必要不充分条件.\n(C) 充要条件.\n(D) 既非充分条件也非必要条件.","answerLatex":"$\\mathrm{A}$","officialAnswer":"A","officialSolution":"","officialSource":"第5页“答案要点”","aiSolution":"第一步, 利用二倍角公式化简函数: $y=\\cos^2(ax)-\\sin^2(ax)=\\cos(2ax)$.\n第二步, 当 $a\\ne0$ 时, $\\cos(2ax)$ 的最小正周期为 $T=\\dfrac{2\\pi}{|2a|}=\\dfrac{\\pi}{|a|}$; 当 $a=0$ 时, 函数为常数, 没有最小正周期.\n\n因此,\"最小正周期为 $\\pi$\"等价于 $|a|=1$, 即 $a=1$ 或 $a=-1$.\n第三步, $a=1$ 能推出周期为 $\\pi$; 但 $a=-1$ 时周期也为 $\\pi$, 不能由周期为 $\\pi$ 推出 $a=1$.\n\n故\"$a=1$\"是\"函数的最小正周期为 $\\pi$\"的充分不必要条件, 选 A.","assetUploadId":null,"difficulty":2,"updatedAt":"2026-09-25 12:39:41","topicIds":["logic-sufficient","trig-period"],"assetUrl":null,"tikzUrls":[],"solutionTikzUrls":[]},{"id":"ba3c2da1-e727-4b9d-9d30-e9a69cc39392","sourceId":"a72493f2-8e1e-46e3-a626-e9db1029e9a5","questionYear":2000,"paperTitle":"2000年上海市普通高等学校春季招生考试数学试卷","questionNumber":"14","questionType":"选择题","stemLatex":"$x=\\sqrt{1-3y^2}$所表示的曲线是\n\n(A) 双曲线.\n(B) 椭圆.\n(C) 双曲线的一部分.\n(D) 椭圆的一部分.","answerLatex":"$\\mathrm{D}$","officialAnswer":"D","officialSolution":"","officialSource":"原件第5页（书页186）“答案要点”选择题答案表","aiSolution":"由$x=\\sqrt{1-3y^2}$可知$x\\geqslant0$, 且$1-3y^2\\geqslant0$. 两边平方, 得$x^2+3y^2=1$. 这是一个椭圆的方程, 但原式还要求$x\\geqslant0$, 因此只取该椭圆的右半部分 (包括上下两个端点).\n\n故选D.","assetUploadId":null,"difficulty":1,"updatedAt":"2026-09-25 12:12:29","topicIds":["ellipse-equation"],"assetUrl":null,"tikzUrls":[],"solutionTikzUrls":[]},{"id":"39c1730d-ed3d-4212-9edf-4174b78a7ebd","sourceId":"a72493f2-8e1e-46e3-a626-e9db1029e9a5","questionYear":2000,"paperTitle":"2000年上海市普通高等学校春季招生考试数学试卷","questionNumber":"12","questionType":"填空题","stemLatex":"设 $I$ 是全集, 非空集合 $P, Q$ 满足 $P\\subset Q\\subset I$. 若含 $P, Q$ 的一个集合运算表达式, 使运算结果为空集 $\\varnothing$, 则这个运算表达式可以是 $\\underline{\\qquad}$(只要写出一个表达式).","answerLatex":"$\\overline{Q}\\cap P$","officialAnswer":"$\\overline{Q}\\cap P$","officialSolution":"","officialSource":"原件第5页“答案要点”，第一大题第12题。","aiSolution":"由 $P\\subset Q$, 可知 $P$ 的每个元素都属于 $Q$.\n\n因此, $P$ 中没有元素属于 $Q$ 在全集 $I$ 中的补集 $\\overline{Q}$, 即 $\\overline{Q}\\cap P=\\varnothing$.\n\n故可填写 $\\overline{Q}\\cap P$.","assetUploadId":null,"difficulty":1,"updatedAt":"2026-09-25 12:03:35","topicIds":["set-operations","set-subsets"],"assetUrl":null,"tikzUrls":[],"solutionTikzUrls":[]},{"id":"71faff07-2094-480d-8c20-dda22b339560","sourceId":"a72493f2-8e1e-46e3-a626-e9db1029e9a5","questionYear":2000,"paperTitle":"2000年上海市普通高等学校春季招生考试数学试卷","questionNumber":"11","questionType":"填空题","stemLatex":"集合 $A=\\{(x, y)\\mid x^2+y^2=4\\}$, $B=\\{(x, y)\\mid (x-3)^2+(y-4)^2=r^2\\}$, 其中 $r>0$, 若 $A\\cap B$ 中有且仅有一个元素, 则 $r$ 的值是 $\\underline{\\qquad}$.","answerLatex":"$3\\text{ 或 }7$","officialAnswer":"3或7","officialSolution":"","officialSource":"原件第5页“答案要点”第11题","aiSolution":"由 $x^2+y^2=4$ 可知, 集合 $A$ 表示圆心为 $(0, 0)$, 半径为 $2$ 的圆; 集合 $B$ 表示圆心为 $(3, 4)$, 半径为 $r$ 的圆. 两圆的圆心距为 $d=\\sqrt{3^2+4^2}=5$. $A\\cap B$ 中有且仅有一个元素, 说明两圆只有一个公共点, 即两圆相切. 外切时, $5=2+r$, 得 $r=3$; 内切时, $5=|r-2|$, 结合 $r>0$, 得 $r=7$.\n\n因此 $r$ 的值是 $3$ 或 $7$.","assetUploadId":null,"difficulty":2,"updatedAt":"2026-09-25 12:01:19","topicIds":["circle-circle","set-operations"],"assetUrl":null,"tikzUrls":[],"solutionTikzUrls":[]},{"id":"cfed08ac-a19e-48dc-93a1-dc4bc2e3f562","sourceId":"a72493f2-8e1e-46e3-a626-e9db1029e9a5","questionYear":2000,"paperTitle":"2000年上海市普通高等学校春季招生考试数学试卷","questionNumber":"10","questionType":"填空题","stemLatex":"有 $n(n\\in\\mathbb N)$ 件不同的产品排成一排, 若其中 $A$, $B$ 两件产品排在一起的不同排法有 $48$ 种, 则 $n=\\underline{\\qquad}$.","answerLatex":"$5$","officialAnswer":"5","officialSolution":"","officialSource":"原件第5页“答案要点”，填空题第10题","aiSolution":"将 $A$, $B$ 两件产品看作一个整体, 它与其余 $n-2$ 件不同的产品共组成 $n-1$ 个排列单位, 有 $(n-1)! $ 种排法. 整体内部的 $A$, $B$ 可以交换位置, 有 $2$ 种排法. 根据题意, $2(n-1)!=48$, 所以 $(n-1)!=24=4! $, 得 $n-1=4$, 故 $n=5$.","assetUploadId":null,"difficulty":2,"updatedAt":"2026-09-25 11:57:07","topicIds":["counting-restrictions","permutations"],"assetUrl":null,"tikzUrls":[],"solutionTikzUrls":[]},{"id":"23696c55-b93e-4f06-951e-0bc171728955","sourceId":"a72493f2-8e1e-46e3-a626-e9db1029e9a5","questionYear":2000,"paperTitle":"2000年上海市普通高等学校春季招生考试数学试卷","questionNumber":"9","questionType":"填空题","stemLatex":"若两个长方体的长, 宽, 高分别为 $5\\mathrm{cm}$, $4\\mathrm{cm}$, $3\\mathrm{cm}$, 把它们两个全等的面重合在一起组成大长方体, 则大长方体的对角线最长为 $\\underline{\\qquad}\\mathrm{cm}$.","answerLatex":"$5\\sqrt{5}$","officialAnswer":"$5\\sqrt{5}$","officialSolution":"","officialSource":"原件第5页“答案要点”第一大题第9题","aiSolution":"两个长方体以全等的面重合后, 大长方体只有一个边长加倍. 按加倍的边长分类, 新长方体的长, 宽, 高分别可以是 $(10, 4, 3)$, $(5, 8, 3)$ 或 $(5, 4, 6)$, 单位均为 $\\mathrm{cm}$.\n\n由长方体体对角线公式 $d=\\sqrt{a^2+b^2+c^2}$, 三种情况下对角线长度的平方分别为 $10^2+4^2+3^2=125$, $5^2+8^2+3^2=98$, $5^2+4^2+6^2=77$. 因为 $125$ 最大, 所以最长对角线为 $\\sqrt{125}=5\\sqrt{5}\\,\\mathrm{cm}$.","assetUploadId":null,"difficulty":2,"updatedAt":"2026-09-25 11:54:55","topicIds":["solid-surface-volume"],"assetUrl":null,"tikzUrls":[],"solutionTikzUrls":[]},{"id":"4bed95b4-17ab-4daa-892f-b17520fa3ea1","sourceId":"a72493f2-8e1e-46e3-a626-e9db1029e9a5","questionYear":2000,"paperTitle":"2000年上海市普通高等学校春季招生考试数学试卷","questionNumber":"5","questionType":"填空题","stemLatex":"在三角形 $ABC$ 中, $\\sqrt{2}\\sin A=\\sqrt{3\\cos A}$, 则 $\\angle A=\\underline{\\qquad}$.","answerLatex":"60^\\circ","officialAnswer":"60°","officialSolution":"","officialSource":"原件第5页“答案要点”第5题","aiSolution":"由 $\\sqrt{2}\\sin A=\\sqrt{3\\cos A}$, 两边平方得 $2\\sin^2 A=3\\cos A$. 令 $c=\\cos A$, 则 $2(1-c^2)=3c$, 即 $(2c-1)(c+2)=0$. 因为 $-1\\leq c\\leq1$, 所以 $c=\\frac12$.\n\n又 $0^\\circ<A<180^\\circ$, 故 $A=60^\\circ$.","assetUploadId":null,"difficulty":2,"updatedAt":"2026-09-25 11:52:42","topicIds":["trig-basic-relations"],"assetUrl":null,"tikzUrls":[],"solutionTikzUrls":[]},{"id":"5725cb6a-420c-4eac-a3ed-d23781110592","sourceId":"a72493f2-8e1e-46e3-a626-e9db1029e9a5","questionYear":2000,"paperTitle":"2000年上海市普通高等学校春季招生考试数学试卷","questionNumber":"3","questionType":"填空题","stemLatex":"方程 $\\log_4(3x-1)=\\log_4(x-1)+\\log_4(3+x)$ 的解是 $\\underline{\\qquad}$.","answerLatex":"x=2","officialAnswer":"x=2","officialSolution":"","officialSource":"原件第5页“答案要点”第一大题第3题","aiSolution":"由对数真数条件得 $x>1$.\n\n由对数运算法则, $3x-1=(x-1)(x+3)$, 即 $x^2-x-2=0$, 解得 $x=2$ 或 $x=-1$.\n\n检验定义域, 只有 $x=2$ 符合条件.","assetUploadId":null,"difficulty":2,"updatedAt":"2026-09-25 11:50:16","topicIds":["logarithm-operations","logarithmic-function"],"assetUrl":null,"tikzUrls":[],"solutionTikzUrls":[]}],"options":{"questionTypes":["选择题","多选题","填空题","解答题","其他"],"sourceCategories":["上海高考","全国高考","学校试卷","教辅习题","其他"],"examTypes":["春考","秋考","模拟考试","月考","期中","期末","联考","其他"],"schoolTiers":["四校","八大","其他"],"provinces":["北京","天津","河北","山西","内蒙古","辽宁","吉林","黑龙江","上海","江苏","浙江","安徽","福建","江西","山东","河南","湖北","湖南","广东","广西","海南","重庆","四川","贵州","云南","西藏","陕西","甘肃","青海","宁夏","新疆","香港","澳门","台湾"]}}